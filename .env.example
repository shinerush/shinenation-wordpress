# ===========================================================================
# shinenation-wordpress — MCP credentials TEMPLATE
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials.
# ===========================================================================

# --- WordPress REST API (Application Password) -----------------------------
# Site URL, no trailing slash. Must be https://
WORDPRESS_SITE_URL=https://shinenationtech.com

# The WordPress *username* (or account email) that owns the Application
# Password — NOT the application-password label.
WORDPRESS_USERNAME=your-wp-username

# The 24-character Application Password from
#   WP Admin -> Users -> Profile -> Application Passwords
# Paste it exactly as shown, spaces included, unquoted.
# Example shape: abcd EFGH 1234 ijkl MNOP 5678
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- Hostinger API (optional, for hosting-level control) -------------------
# Generate at: hPanel -> Account -> API -> Generate new token.
# Leave EMPTY to use the interactive OAuth browser flow instead.
HOSTINGER_API_TOKEN=
