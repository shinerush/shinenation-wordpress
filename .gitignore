# ---------------------------------------------------------------------------
# Secrets — NEVER commit these.
# The WordPress Application Password and Hostinger API token live here only.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.json
.mcp.local.json

# Live MCP config — generated from .mcp.json.example on the machine that runs
# the servers. Ignored so it never auto-loads (and fails) in a cloud sandbox.
.mcp.json
!.mcp.json.example
credentials.json
secrets/
*.pem
*.key

# Hostinger MCP OAuth credential cache (if ever copied into the repo)
.config/hostinger-mcp/

# Claude Code local (machine-specific, may contain resolved secrets)
.claude/settings.local.json

# Tooling
node_modules/
vendor/
.DS_Store
*.log
