{
  "$comment": [
    "Project-scoped MCP servers for shinenationtech.com.",
    "NO SECRETS IN THIS FILE. Values are resolved at launch from the",
    "environment via ${VAR} expansion. Load them first, e.g.:",
    "  set -a; source .env; set +a; claude",
    "See docs/MCP_SETUP.md for the full walkthrough."
  ],
  "mcpServers": {
    "wordpress": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-wordpress"],
      "env": {
        "WORDPRESS_SITE_URL": "${WORDPRESS_SITE_URL:-https://shinenationtech.com}",
        "WORDPRESS_USERNAME": "${WORDPRESS_USERNAME}",
        "WORDPRESS_APP_PASSWORD": "${WORDPRESS_APP_PASSWORD}"
      }
    },
    "hostinger": {
      "type": "http",
      "url": "https://mcp.hostinger.com"
    }
  }
}
